# =============================
# Hardhat
# =============================

# OBLIGATORIO para deploy — private key de la wallet que despliega
# (SIN prefijo 0x). NUNCA la compartas ni la subas.
PRIVATE_KEY=

# =============================
# RPC URLs
# =============================

# RPC para cada red (obligatorias para deploy/verify en esa red).
# Consíguelas en Alchemy, Infura, o el proveedor de tu preferencia.

# Arbitrum One
ARBITRUM_RPC_URL=

# Arbitrum Sepolia
ARBITRUM_SEPOLIA_RPC_URL=

# Base
BASE_RPC_URL=

# Base Sepolia
BASE_SEPOLIA_RPC_URL=

# Monad Testnet
MONAD_TESTNET_RPC_URL=

# =============================
# Explorers (verificación)
# =============================

# API keys de los explorers para verificación de contratos
# (obligatorias para npm run verify:*)

# Arbiscan — https://arbiscan.io/apis
ARBISCAN_API_KEY=

# Basescan — https://basescan.org/apis
BASESCAN_API_KEY=

# =============================
# Extras
# =============================

# Reporte de gas en tests (true|false)
REPORT_GAS=false
