# =============================
# Para — Embedded Wallet SDK
# =============================

# OBLIGATORIO — API key de Para (cliente).
# Crea tu proyecto y API key gratis en https://cloud.getpara.com
# En BETA puedes probar el login con cualquier email *@test.getpara.com y OTP 123456.
NEXT_PUBLIC_PARA_API_KEY=

# =============================
# WalletConnect (wallets externas)
# =============================

# OPCIONAL — Project ID del protocolo WalletConnect para conectar wallets
# externas vía QR (Rainbow, Trust, Rabby, ...). MetaMask/Coinbase instaladas
# funcionan sin esto (injected provider).
# Crea uno gratis en https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# =============================
# RPC URLs (opcional)
# =============================

# OPCIONAL — Si no defines ninguna, se usan RPCs públicos por defecto.
# Define solo las cadenas que tu dApp va a usar.

# Arbitrum One
NEXT_PUBLIC_ARBITRUM_RPC_URL=

# Arbitrum Sepolia
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=

# Base
NEXT_PUBLIC_BASE_RPC_URL=

# Base Sepolia
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Monad Testnet
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=
